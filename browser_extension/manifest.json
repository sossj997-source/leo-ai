{
  "manifest_version": 3,
  "name": "Leo Browser Controller",
  "version": "1.0.0",
  "description": "Lets Leo control the existing Chrome profile without CDP.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8765/*"],
  "background": {"service_worker": "service_worker.js"},
  "action": {"default_title": "Leo Browser Controller"}
}
